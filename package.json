{
    "name": "webauthn-interceptor",
    "version": "0.1.0",
    "description": "Intercepts WebAuthn requests and responses for inspection and modification.",
    "private": true,
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tantosec/webauthn-interceptor.git"
    },
    "bugs": {
        "url": "https://github.com/tantosec/webauthn-interceptor/issues"
    },
    "homepage": "https://github.com/tantosec/webauthn-interceptor#readme",
    "packageManager": "pnpm@11.22.0",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "build:css": "node node_modules/tailwindcss/lib/cli.js -i ./public/ui/tailwind-input.css -o ./public/ui/interceptor-modal.css --minify",
        "watch:css": "node node_modules/tailwindcss/lib/cli.js -i ./public/ui/tailwind-input.css -o ./public/ui/interceptor-modal.css --watch",
        "build": "pnpm run typecheck && pnpm run build:css && webpack --mode production",
        "watch": "pnpm exec concurrently \"pnpm run watch:css\" \"webpack --mode development --watch\"",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
        "test": "pnpm build && playwright test --project=local",
        "format": "prettier --write src public/popup public/ui/*.html public/ui/tailwind-input.css tests *.ts *.js *.json README.md",
        "format:check": "prettier --check src public/popup public/ui/*.html public/ui/tailwind-input.css tests *.ts *.js *.json README.md"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@types/chrome": "^0.0.261",
        "@types/node": "^26.6.3",
        "concurrently": "^8.2.2",
        "copy-webpack-plugin": "^14.0.0",
        "prettier": "^3.9.9",
        "tailwindcss": "^3.4.19",
        "ts-loader": "^9.6.2",
        "typescript": "^5.9.3",
        "webpack": "^5.109.2",
        "webpack-cli": "^5.1.4"
    },
    "dependencies": {
        "@levischuck/tiny-cbor": "^0.3.6",
        "@simplewebauthn/browser": "^13.3.0"
    }
}
