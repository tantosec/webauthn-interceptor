{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "outDir": "./dist_ts_temp",
        "rootDir": ".",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "noEmit": true,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "include": ["src/**/*.ts", "public/popup/popup.ts"],
    "exclude": ["node_modules"]
}
